{
  "name": "codemaster-lms",
  "version": "1.0.0",
  "description": "CodeMaster LMS Full-Stack Platform (Netlify + PostgreSQL + Express)",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@netlify/database": "latest",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "prisma": "^5.21.1",
    "serverless-http": "^3.2.0"
  }
}
