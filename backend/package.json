{
  "name": "codemaster-lms-backend",
  "version": "1.0.0",
  "description": "CodeMaster LMS Backend with SQLite and Prisma ORM",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "test": "node test-suite.js && node test-http.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "prisma": "^5.21.1"
  }
}
